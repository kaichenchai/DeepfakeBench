#!/bin/bash
#rj name=effort-ce-hsic-16
#rj queue=curtin_eecms
#rj gpus=a100:2
#rj nodes=1
#rj taskspernode=1
#rj cpus=*
#rj mem=200G
#rj runtime=10
#rj logdir=logs/slurm
#rj priority=550
#rj features=a100
#rj array=0

TRAIN_DATASET="FaceForensics++"
TEST_DATASET="FaceForensics++"

CONFIGS=(
    "./training/config/detector/effort_ce_hsic_16.yaml"
    "./training/config/detector/effort_ce_hsic_masked_counterfactual_backbone_clip_cf_4.yaml"
    "./training/config/detector/effort_ce_hsic_masked_counterfactual_backbone_clip_cf_8.yaml"
    "./training/config/detector/effort_ce_hsic_masked_counterfactual_backbone_clip_cf_16.yaml"
    "./training/config/detector/effort_ce_hsic_masked_counterfactual_backbone_clip_cf_32.yaml"
)

# Bash Strict Mode
set -euo pipefail

TASK_ID=${SLURM_ARRAY_TASK_ID:-0}
N_CONFIGS=${#CONFIGS[@]}

if [ "$TASK_ID" -ge "$N_CONFIGS" ]; then
    echo "[job] SLURM_ARRAY_TASK_ID=$TASK_ID out of range (max $((N_CONFIGS-1))) — exiting"
    exit 0
fi

DETECTOR_CONFIG="${CONFIGS[$TASK_ID]}"

echo "=============================================="
echo "  [job] Array Task $TASK_ID / $((N_CONFIGS-1))"
echo "  [job] Config: $DETECTOR_CONFIG"
echo "  [job] Started at: $(date)"
echo "=============================================="

# Activate virtual environment managed by uv (MUST be in repo root)
source .venv/bin/activate

# Load environment variables (wandb API key, etc.)
if [ -f .env ]; then
    set -a; source .env; set +a
fi

# Redirect multiprocessing temp dir to local storage to avoid
# "Device or resource busy" errors on Lustre during worker cleanup
export TMPDIR=/tmp/slurm_job_${SLURM_JOB_ID}_${TASK_ID}
mkdir -p "$TMPDIR"

torchrun --nproc_per_node=2 \
    training/train.py \
    --detector_path "$DETECTOR_CONFIG" \
    --train_dataset "$TRAIN_DATASET" \
    --test_dataset "$TEST_DATASET" \
    --ddp

# Clean up local temp directory
rm -rf "$TMPDIR"

echo "[job] Training ($DETECTOR_CONFIG) finished at $(date)."