#!/bin/bash
#rj name=effort_ce_ddp
#rj gpus=a100:4
#rj nodes=1
#rj taskspernode=1
#rj cpus=*
#rj mem=200G
#rj runtime=1
#rj logdir=logs/slurm
#rj priority=550

# Bash Strict Mode
set -euo pipefail

# Activate virtual environment managed by uv
source .venv/bin/activate

# Execute training using torchrun
# - nproc_per_node=4 matches the 4 GPUs requested above
torchrun --nproc_per_node=4 \
    training/train.py \
    --detector_path ./training/config/detector/effort_ce_one_epoch.yaml \
    --train_dataset "FaceForensics++" \
    --test_dataset "FaceForensics++" \
    --ddp

echo "Training job finished."