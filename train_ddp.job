#!/bin/bash
#rj name=effort_hsic_orthogonal_weight_cf_bb
#rj runtime=3
#rj logdir=logs/slurm
#rj priority=550
#rj features=a100

# Bash Strict Mode
set -euo pipefail

# Activate virtual environment managed by uv
source .venv/bin/activate

# Redirect multiprocessing temp dir to local storage to avoid
# "Device or resource busy" errors on Lustre during worker cleanup
export TMPDIR=/tmp/slurm_job_${SLURM_JOB_ID}
mkdir -p "$TMPDIR"

torchrun --nproc_per_node=2 \
    training/train.py \
    --detector_path ./training/config/detector/effort.yaml \
    --train_dataset "FaceForensics++" \
    --test_dataset "FaceForensics++" \
    --ddp

# torchrun --nproc_per_node=2 \
#     training/train.py \
#     --detector_path ./training/config/detector/effort_ce_hsic_masked_counterfactual_backbone.yaml \
#     --train_dataset "FaceForensics++" \
#     --test_dataset "FaceForensics++" \
#     --ddp

# torchrun --nproc_per_node=2 \
#     training/train.py \
#     --detector_path ./training/config/detector/effort_ce_hsic_orthogonal_masked_counterfactual_backbone.yaml \
#     --train_dataset "FaceForensics++" \
#     --test_dataset "FaceForensics++" \
#     --ddp

# torchrun --nproc_per_node=2 \
#     training/train.py \
#     --detector_path ./training/config/detector/effort_ce_hsic_orthogonal_weight_masked_counterfactual_backbone.yaml \
#     --train_dataset "FaceForensics++" \
#     --test_dataset "FaceForensics++" \
#     --ddp

# Clean up local temp directory
rm -rf "$TMPDIR"

echo "Training job finished."