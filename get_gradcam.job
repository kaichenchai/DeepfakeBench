#!/bin/bash
#rj name=gradcam
#rj queue=curtin_eecms
#rj runtime=10
#rj logdir=logs/slurm
#rj priority=550
#rj features=a100
#rj cpus=8
#rj mem=64G
#rj gpus=a100:1
# Keep this equal to 0-(number of entries in PAIRS below - 1).
#rj array=0-1

# Bash Strict Mode
set -euo pipefail

# Activate virtual environment managed by uv
source .venv/bin/activate

# Redirect multiprocessing temp dir to local storage to avoid
# "Device or resource busy" errors on Lustre during worker cleanup
export TMPDIR=/tmp/slurm_job_${SLURM_JOB_ID:-local}_${SLURM_ARRAY_TASK_ID:-0}
mkdir -p "$TMPDIR"

# ══════════════════════════════════════════════════════════════════════════════
# MODEL ENTRIES — each entry runs as its own ARRAY TASK in PARALLEL.
# Keep `#rj array` above equal to 0-(number of entries - 1).
# Format: "CONFIG|WEIGHTS|OUTPUT_DIR"
# ══════════════════════════════════════════════════════════════════════════════
PAIRS=(
    "training/config/detector/effort_ce_orthogonal_weight.yaml|logs/training/effort_ce_orthogonal_weight_effort_custom_2026-08-23-19-55-41/final/ckpt_final.pth|eval/gradcam/data/effort"
    "training/config/detector/effort_ce_hsic_masked_counterfactual_backbone_clip_cf.yaml|logs/training/effort_ce_hsic_masked_counterfactual_backbone_clip_cf_effort_custom_seed_1024_2026-10-04-23-07-22/final/ckpt_final.pth|eval/gradcam/data/ce_hsic_cf"
)
# For the paper's pretrained EFFORT instead of the retrained baseline, replace
# the first entry with:
#   "training/config/detector/effort.yaml|training/pretrained/effort_clip_L14_trainOn_FaceForensic.pth|eval/gradcam/data/effort"

TASK_ID=${SLURM_ARRAY_TASK_ID:-0}
TOTAL=${#PAIRS[@]}

if [ "$TASK_ID" -ge "$TOTAL" ]; then
    echo "[job] SLURM_ARRAY_TASK_ID=$TASK_ID out of range (max $((TOTAL-1))) — exiting"
    exit 0
fi

IFS='|' read -r CONFIG WEIGHTS OUTPUT_DIR <<< "${PAIRS[$TASK_ID]}"

echo "=============================================="
echo "  [job] Task $TASK_ID / $((TOTAL-1))"
echo "  [job] Config:   $CONFIG"
echo "  [job] Weights:  $WEIGHTS"
echo "  [job] Output:   $OUTPUT_DIR"
echo "  [job] Hostname: $(hostname)"
echo "  [job] Started:  $(date)"
echo "=============================================="

if [ ! -f "$CONFIG" ]; then
    echo "[job] ERROR: config not found: $CONFIG"
    exit 1
fi
if [ ! -f "$WEIGHTS" ]; then
    echo "[job] ERROR: weights not found: $WEIGHTS"
    exit 1
fi

# Fail fast if the allocated GPU is not visible to PyTorch.
python - <<'PY'
import torch
print(
    f"torch={torch.__version__} cuda={torch.version.cuda} "
    f"available={torch.cuda.is_available()}",
    flush=True,
)
if not torch.cuda.is_available():
    raise SystemExit(
        "CUDA is not available to PyTorch; refusing to run GradCAM on CPU."
    )
print(f"GPU: {torch.cuda.get_device_name(0)}", flush=True)
PY

python eval/gradcam/generate_gradcam.py \
    --config "$CONFIG" \
    --weights "$WEIGHTS" \
    --dataset FaceForensics++ \
    --output-dir "$OUTPUT_DIR" \
    --device cuda \
    --categories real_high fake_high misclassified_low misclassified_high \
    --per-category 4 \
    --scan-samples 4096 \
    --scan-batch-size 32 \
    --high-confidence 0.90 \
    --low-confidence 0.65 \
    --target-class pred \
    --seed 1024 \
    --summary-samples 8

echo "[job] Task $TASK_ID finished at $(date)"
