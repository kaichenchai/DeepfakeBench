#!/bin/bash
#rj name=effort_cross_dataset_test
#rj queue=curtin_eecms
#rj runtime=10
#rj logdir=logs/slurm/cross_dataset_test
#rj priority=550
#rj features=a100
#rj array=0-1


# ══════════════════════════════════════════════════════════════════════════════
# CONFIG / WEIGHT PAIRS — each pair runs as its own ARRAY TASK in PARALLEL.
# Uses final/ckpt_final.pth. Task index 0..34 maps to SLURM_ARRAY_TASK_ID.
# Add/remove entries here to change what gets evaluated.
# Each entry: "CONFIG|WEIGHTS_DIR"
# ══════════════════════════════════════════════════════════════════════════════
CFG_DIR="./training/config/detector"
TRAINING_DIR="./logs/training"

PAIRS=(
    "effort_ce_kl_decision.yaml|effort_ce_kl_decision_effort_custom_clip_counterfactual_2026-09-06-23-46-33"
    "effort_ce_masked_counterfactual_backbone_fake_only.yaml|effort_ce_masked_counterfactual_backbone_fake_only_effort_custom_clip_counterfactual_new_loss_2026-09-07-02-16-07"
 )


TASK_ID=${SLURM_ARRAY_TASK_ID:-0}
TOTAL=${#PAIRS[@]}

if [ "$TASK_ID" -ge "$TOTAL" ]; then
    echo "[job] SLURM_ARRAY_TASK_ID=$TASK_ID out of range (max $((TOTAL-1))) — exiting"
    exit 0
fi

IFS='|' read -r CONFIG_NAME WEIGHTS_DIR_NAME <<< "${PAIRS[$TASK_ID]}"
DETECTOR_CONFIG="${CFG_DIR}/${CONFIG_NAME}"
WEIGHTS="${TRAINING_DIR}/${WEIGHTS_DIR_NAME}/final/ckpt_final.pth"

echo "=============================================="
echo "  [job] Job started at $(date)"
echo "  [job] SLURM_JOB_ID=${SLURM_JOB_ID:-N/A}"
echo "  [job] SLURM_ARRAY_TASK_ID=$TASK_ID / $((TOTAL-1))"
echo "  [job] Hostname: $(hostname)"
echo "  [job] Working dir: $(pwd)"
echo "  [job] Total pairs: $TOTAL"
echo "=============================================="

echo "[job] Activating virtual environment..."
# Activate virtual environment managed by uv
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
    echo "[job] Virtual environment activated."
    # Load environment variables (wandb API key, etc.)
    if [ -f .env ]; then
        set -a; source .env; set +a
    fi
else
    echo "[job] ERROR: .venv/bin/activate not found! Searching for python..."
fi

PYTHON_BIN="$(command -v python3 || command -v python || echo 'NOT_FOUND')"
echo "[job] Python binary: ${PYTHON_BIN}"
if [ "${PYTHON_BIN}" != "NOT_FOUND" ]; then
    ${PYTHON_BIN} --version 2>&1 || true
else
    echo "[job] ERROR: No Python found!"
fi

echo "[job] Setting up temp directory..."
# Redirect multiprocessing temp dir to local storage to avoid
# "Device or resource busy" errors on Lustre during worker cleanup
export TMPDIR=/tmp/slurm_job_${SLURM_JOB_ID}_${SLURM_ARRAY_TASK_ID}
mkdir -p "$TMPDIR" || { echo "[job] ERROR: Could not create TMPDIR=$TMPDIR"; }
echo "[job] TMPDIR=$TMPDIR"

echo "[job] Checking dataset directories..."
for ds in FaceForensics++ UADFV Celeb-DF-v1 Celeb-DF-v2 DFDC DFDCP; do
    if [ -d "./datasets/rgb/$ds" ]; then
        echo "  [job]   Dataset found: ./datasets/rgb/$ds"
    else
        echo "  [job]   WARNING: Dataset NOT found: ./datasets/rgb/$ds"
    fi
done

echo "=============================================="
echo "  [job] Array Task $TASK_ID:"
echo "  [job]   Config:  $CONFIG_NAME"
echo "  [job]   Weights: $WEIGHTS_DIR_NAME/final/ckpt_final.pth"
echo "  [job] Started at: $(date)"
echo "=============================================="

set -euo pipefail

if [ ! -f "$DETECTOR_CONFIG" ]; then
    echo "  [ERROR] Config not found: $DETECTOR_CONFIG  — EXITING"
    exit 1
fi
if [ ! -f "$WEIGHTS" ]; then
    echo "  [ERROR] Weights not found: $WEIGHTS  — EXITING"
    exit 1
fi

# Derive short model label from the config name: effort_ce_hsic.yaml -> ce_hsic
MODEL_LABEL="$(basename "${CONFIG_NAME%.yaml}")"
MODEL_LABEL="${MODEL_LABEL#effort_}"

# Derive seed from the run folder; base-named (seed-1024) runs have no _seed_ token
if [[ "$WEIGHTS_DIR_NAME" =~ _seed_([0-9]+)_ ]]; then
    SEED="${BASH_REMATCH[1]}"
else
    SEED="1024"
fi

# Read the config's run_name from the YAML for the wandb run name
CONFIG_RUN_NAME="$(grep -E '^[[:space:]]*run_name:' "$DETECTOR_CONFIG" | head -n1 | sed -E 's/^[[:space:]]*run_name:[[:space:]]*//; s/[[:space:]]*#.*$//')"
CONFIG_RUN_NAME="${CONFIG_RUN_NAME//\"/}"
CONFIG_RUN_NAME="${CONFIG_RUN_NAME//\'/}"
CONFIG_RUN_NAME="${CONFIG_RUN_NAME:-$(basename "${CONFIG_NAME%.yaml}")}"
echo "  [job] Run label: ${MODEL_LABEL} / seed ${SEED} / config run_name: ${CONFIG_RUN_NAME}"

# Unique per-task output dir so concurrent tasks never collide on result files
TASK_OUT_DIR="${TMPDIR}/result_${TASK_ID}"
mkdir -p "$TASK_OUT_DIR"
echo "  [job] Task output dir: $TASK_OUT_DIR"

python training/cross_dataset_test.py \
    --detector_path "$DETECTOR_CONFIG" \
    --weights_path "$WEIGHTS" \
    --checkpoint_type final \
    --output_dir "$TASK_OUT_DIR" \
    --wandb_name "cross_dataset_test_${CONFIG_RUN_NAME}_seed_${SEED}" \
    --wandb_extra_tags multiple_seeds_test

# Rename this task's result JSON to a descriptive, collision-free name
RESULT_FILE="$(ls -1 "$TASK_OUT_DIR"/cross_dataset_results_*.json 2>/dev/null | head -n1)"
if [ -n "$RESULT_FILE" ]; then
    DEST_DIR="./logs/cross_dataset_test/multiple_seeds/${SEED}"
    mkdir -p "$DEST_DIR"
    DEST="${DEST_DIR}/cross_dataset_results_${MODEL_LABEL}_seed_${SEED}.json"
    mv -f "$RESULT_FILE" "$DEST"
    echo "  [job] Results saved to: $DEST"
else
    echo "  [job] WARNING: No result JSON produced in $TASK_OUT_DIR"
fi

echo ""
echo "=============================================="
echo "  [job] Array Task $TASK_ID PASSED at $(date)"
echo "=============================================="

echo "[job] Cleaning up local temp directory..."
rm -rf "$TMPDIR"

echo "[job] Testing job finished at $(date)."