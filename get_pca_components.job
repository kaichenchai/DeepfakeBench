#!/bin/bash
#rj name=eval
#rj queue=curtin_eecms
#rj runtime=10
#rj logdir=logs/slurm
#rj priority=550
#rj features=a100
#rj cpus=8
#rj mem=64G
#rj gpus=a100:1

# Bash Strict Mode
set -euo pipefail

# Activate virtual environment managed by uv
source .venv/bin/activate

# Redirect multiprocessing temp dir to local storage to avoid
# "Device or resource busy" errors on Lustre during worker cleanup
export TMPDIR=/tmp/slurm_job_${SLURM_JOB_ID}
mkdir -p "$TMPDIR"

# python eval/pca/calculate_components.py \
#     --model-file eval/pca/effort_features.npy \
#     --threshold 90 \
#     --output eval/pca/effort_results.json \

# python eval/pca/calculate_components.py \
#     --model-file eval/pca/hsic_cf_features.npy \
#     --threshold 90 \
#     --output eval/pca/hsic_cf_features.json \

python eval/pca/calculate_components.py \
    --model-file eval/pca/vanilla_clip_features.npy \
    --threshold 90 \
    --output eval/pca/vanilla_clip_features.json